<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <title>Error</title>
  <style>
    .error-container {
      max-width: 600px;
      margin: 50px auto;
      padding: 20px;
      border: 1px solid #f5222d;
      border-radius: 4px;
      background-color: #fff1f0;
    }
    .error-title {
      color: #f5222d;
      font-size: 24px;
      margin-bottom: 10px;
    }
    .error-status {
      font-size: 18px;
      color: #1890ff;
      margin-bottom: 20px;
    }
    .error-stack {
      background-color: #fafafa;
      padding: 10px;
      border-radius: 4px;
      overflow-x: auto;
      font-family: monospace;
      font-size: 12px;
      color: #333;
    }
    .error-back {
      margin-top: 20px;
    }
    .error-back a {
      color: #1890ff;
      text-decoration: none;
    }
    .error-back a:hover {
      text-decoration: underline;
    }
  </style>
</head>
<body>
  <div class="error-container">
    <h1 class="error-title"><%= message %></h1>
    <p class="error-status">Status: <%= error.status || 500 %></p>
    <% if (error.stack) { %>
    <pre class="error-stack"><%= error.stack %></pre>
    <% } %>
    <div class="error-back">
      <a href="/">← Go back home</a>
    </div>
  </div>
</body>
</html>
