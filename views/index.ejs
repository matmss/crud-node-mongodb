<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <title><%= title %> - Task Manager</title>
</head>
<body>
  <header class="bg-dark">
    <div class="col-100">
      <h1 class="color-white"><%= title %></h1>
    </div>
  </header>
  <section>
    <div class="col-30 bg-grey">
      <form action="/add" method="post">
        <legend>Add Task</legend>
        <input 
          type="text" 
          name="title" 
          placeholder="Title" 
          required
          maxlength="100">
        <textarea 
          name="description" 
          cols="30" 
          rows="10" 
          placeholder="Description" 
          maxlength="500"></textarea>
        <button type="submit">+ Add Task</button>
      </form>
    </div>
    <div class="col-70">
      <% if (tasks && tasks.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% tasks.forEach((task) => { %>
          <tr class="<%= task.status ? 'completed' : '' %>">
            <td><strong><%= task.title %></strong></td>
            <td><%= task.description || '-' %></td>
            <td><span class="<%= task.status ? 'badge-success' : 'badge-pending' %>"><%= task.status ? 'Completed' : 'Pending' %></span></td>
            <td class="actions">
              <a href="/toggle/<%= task._id %>" class="btn-toggle">Toggle</a>
              <a href="/delete/<%= task._id %>" class="btn-delete" onclick="return confirm('Are you sure?')">Delete</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
      <p class="empty-state">No tasks yet. Create your first task!</p>
      <% } %>
    </div>
  </section>
</body>
</html>
